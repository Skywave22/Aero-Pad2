<?xml version="1.0" encoding="utf-8"?>
<!--
  AeroPad logo (v2): a rounded "A" touch monogram.
    - wireless wave over the apex  → over-the-air / Bluetooth
    - swiped crossbar              → the trackpad gesture
    - touch dot below              → the pad itself
  Pure white strokes: doubles as the monochrome/themed-icon layer.
  Viewport 108 (adaptive icon); glyph sits inside the 66dp safe zone.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- A: left leg -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M50,27 L31.5,77" />

    <!-- A: right leg -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="9"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M58,27 L76.5,77" />

    <!-- swiped crossbar (trackpad gesture) -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M41.5,60 Q54,51.5 66.5,60" />

    <!-- wireless wave -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M45,19 Q54,12.5 63,19" />

    <!-- touch dot -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M50,80.5 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0" />
</vector>
