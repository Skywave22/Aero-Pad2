# Gradle / build
.gradle/
build/
app/build/
local.properties

# IDE
.idea/
*.iml
.DS_Store

# Signing — NEVER commit these
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
# Signing material only — anchored so it cannot swallow source packages
# named `keys` (model/keys, data/keys). A bare `keys/` pattern matched any
# directory with that name at any depth, which silently kept real Kotlin
# sources out of the repository.
/keys/

# ---------------------------------------------------------------------------
# Round 13 — DELIBERATE exception: the AeroPad release key lives in the repo.
#
# Why: the GitHub secrets that used to hold it were removed after v3.5.0, so
# every v3.6.0 build silently fell back to the Android DEBUG key and could not
# be installed over an existing install. The token available to fix this cannot
# write repository secrets, so the key ships with the build instead.
#
# This is a trade-off, not best practice: **this repository is public**, so
# anyone holding this key can sign an APK claiming to be AeroPad. Install
# AeroPad only from this repository's Releases page. To move the key back into
# secrets, run `tools/release-signing.sh --keystore keys/release/aeropad-release.p12`
# and then delete the files below — the build prefers secrets when they exist.
# See keys/release/README.md and docs/SIGNING.md.
# ---------------------------------------------------------------------------
!/keys/
!/keys/release/
!/keys/release/aeropad-release.p12
!/keys/release/keystore.properties

# Misc
captures/
.externalNativeBuild/
.cxx/
