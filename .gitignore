# Gradle / build
.gradle/
build/
app/build/
local.properties

# IDE
.idea/
*.iml
.DS_Store

# Signing — NEVER commit these
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
# Signing material only — anchored so it cannot swallow source packages
# named `keys` (model/keys, data/keys). A bare `keys/` pattern matched any
# directory with that name at any depth, which silently kept real Kotlin
# sources out of the repository.
/keys/

# ---------------------------------------------------------------------------
# Round 17 — the release key is a repository SECRET, not a file here.
#
# Rounds 13–16 kept it committed at keys/release/ because CI had no secret
# access. That was a hole in a public repository: anyone could sign an APK
# claiming to be AeroPad. The key now lives in repository secrets
# (KEYSTORE_B64 / KEYSTORE_PASS / KEY_ALIAS / KEY_PASS) and the workflow
# fails instead of falling back to the debug key. Nothing under /keys/ is
# whitelisted any more — see docs/SIGNING.md.
# ---------------------------------------------------------------------------

# Misc
captures/
.externalNativeBuild/
.cxx/
